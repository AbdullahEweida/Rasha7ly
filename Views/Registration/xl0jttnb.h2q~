@model Rasha7ly.ViewModels.PrerequisitesViewModel

@{
    ViewData["Title"] = "تأكيد المواد المكتملة";
}

<div class="container my-5" dir="rtl">
    <div class="d-flex justify-content-center align-items-center mb-5">
        <div class="text-muted mx-3">3. التسجيل</div>
        <div class="text-muted mx-3">2. الجدول الدراسي</div>
        <div class="badge bg-success p-2 px-3 rounded-pill text-white mx-3">1. المتطلبات السابقة</div>
    </div>

    <div class="mb-4">
        <h2 class="fw-bold text-dark">تأكيد المواد المكتملة</h2>
        <p class="text-muted">اختر جميع المواد التي أتممتها بنجاح لفتح المواد المتقدمة.</p>
    </div>

    <form asp-action="SavePrerequisites" method="post">
        <div class="row g-3">
            @for (int i = 0; i < Model.AvailableCourses.Count; i++)
            {
                <div class="col-md-3">
                    <div class="card h-100 border-0 shadow-sm p-3 position-relative rounded-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="fw-bold text-dark">@Model.AvailableCourses[i].Code</span>
                            <input type="hidden" asp-for="AvailableCourses[i].Code" />
                            <input type="hidden" asp-for="AvailableCourses[i].Name" />
                            
                            <div class="form-check">
                                <input class="form-check-input custom-checkbox" type="checkbox" asp-for="AvailableCourses[i].IsPassed" data-credit-hours="@Model.AvailableCourses[i].CreditHours" />
                            </div>
                        </div>
                        <p class="text-muted small mb-0">@Model.AvailableCourses[i].Name</p>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
            <button type="submit" class="btn btn-dark px-4 py-2 rounded-3">
                الخطوة التالية &larr;
            </button>
            <div class="text-muted small">
                <span id="selectedCount" class="fw-bold text-dark">0</span> ساعات معتمدة
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.custom-checkbox').forEach(cb => {
            cb.addEventListener('change', function() {
                document.getElementById('selectedCount').innerText = document.querySelectorAll('.custom-checkbox:checked').length;
            });
        });
    </script>
}